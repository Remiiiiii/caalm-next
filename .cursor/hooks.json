{
	"version": 1,
	"hooks": {
		"postToolUse": [
			{
				"matcher": "Read|Grep|Glob|Search|Shell",
				"command": "node .cursor/hooks/graft-hooks.cjs cursor-post-tool",
				"timeout": 30
			}
		],
		"afterMCPExecution": [
			{
				"command": "node .cursor/hooks/graft-hooks.cjs cursor-mcp",
				"timeout": 30
			}
		],
		"sessionEnd": [
			{
				"command": "node .cursor/hooks/graft-hooks.cjs cursor-session-end",
				"timeout": 30
			}
		]
	}
}
