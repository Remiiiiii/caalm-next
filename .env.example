# --- IT, tickets, roadmap ---
NEXT_PUBLIC_APPWRITE_RUNBOOKS_COLLECTION=runbooks_collection_id
NEXT_PUBLIC_APPWRITE_TICKETS_COLLECTION=tickets_collection_id
