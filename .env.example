# --- News, notes, assistant ---
NEXT_PUBLIC_APPWRITE_NEWS_ARTICLES_COLLECTION=news_articles_collection_id
NEXT_PUBLIC_APPWRITE_NEWS_VERSIONS_COLLECTION=news_versions_collection_id
NEXT_PUBLIC_APPWRITE_NOTES_COLLECTION=notes_collection_id
NEXT_PUBLIC_APPWRITE_ASSISTANT_CONVERSATIONS_COLLECTION=assistant_conversations
