# ==========================================
# APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=next_server_actions_encryption_key

# ==========================================
# APPWRITE
# ==========================================
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=project_id
NEXT_PUBLIC_APPWRITE_DATABASE=database_id
NEXT_PUBLIC_APPWRITE_BUCKET=bucket_id
# name: contract_blueprints
NEXT_PUBLIC_APPWRITE_CONTRACT_BLUEPRINTS_BUCKET=contract_blueprints_bucket_id
NEXT_PUBLIC_APPWRITE_PROFILE_PICTURES_BUCKET=profile_pictures_bucket_id
NEXT_APPWRITE_API_KEY=next_appwrite_api_key
APPWRITE_NOTIFICATION_API_KEY=appwrite_notification_api_key
APPWRITE_FUNCTION_PROJECT_ID=appwrite_function_project_id
APPWRITE_FUNCTION_ENDPOINT=https://fra.cloud.appwrite.io/v1

# ==========================================
# APPWRITE COLLECTIONS
# ==========================================
# Use alphanumeric table $id values. The name: comments are Console labels.

# --- Users, org, RBAC ---
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION=user_collection_id
NEXT_PUBLIC_APPWRITE_PERMISSIONS_COLLECTION=permissions_collection_id
NEXT_PUBLIC_APPWRITE_ORG_UNITS_COLLECTION=org_units_collection_id
NEXT_PUBLIC_APPWRITE_COST_CENTERS_COLLECTION=cost_centers_collection_id
NEXT_PUBLIC_APPWRITE_ORG_UNIT_HISTORY_COLLECTION=org_unit_history_collection_id
NEXT_PUBLIC_APPWRITE_INVITATIONS_COLLECTION=invitations_collection_id
NEXT_PUBLIC_APPWRITE_OTPTOKENS_COLLECTION=otp_tokens_collection_id

# --- Contracts & licenses ---
NEXT_PUBLIC_APPWRITE_CONTRACTS_COLLECTION=contract_collection_Id
NEXT_PUBLIC_APPWRITE_CONTRACT_DRAFTS_COLLECTION=contract_drafts_collection_id
NEXT_PUBLIC_APPWRITE_CONTRACT_EXTENSIONS_COLLECTION=contract_extensions_collection_id
NEXT_PUBLIC_APPWRITE_CONTRACTS_ENTERPRISE_METADATA_COLLECTION=contracts_enterprise_metadata_collection_id
NEXT_PUBLIC_APPWRITE_LICENSES_COLLECTION=licenses_collection_id
NEXT_PUBLIC_APPWRITE_LICENSE_DRAFTS_COLLECTION=license_drafts_collection_id
NEXT_PUBLIC_APPWRITE_CLAUSES_COLLECTION=clauses_collection_id
# name: contract_templates
NEXT_PUBLIC_APPWRITE_CONTRACT_TEMPLATES_COLLECTION=contract_templates_collection_id
# name: contract_wizard_sessions
NEXT_PUBLIC_APPWRITE_CONTRACT_WIZARD_SESSIONS_COLLECTION=contract_wizard_sessions_collection_id
NEXT_PUBLIC_APPWRITE_FILES_COLLECTION=files_collection_id
NEXT_PUBLIC_APPWRITE_TASKS_COLLECTION=tasks

# --- Calendar ---
NEXT_PUBLIC_APPWRITE_CALENDAR_EVENTS_COLLECTION=calendar_events_collection_id
NEXT_PUBLIC_APPWRITE_CALENDAR_APPROVALS_COLLECTION=calendar_approvals_collection_id
NEXT_PUBLIC_APPWRITE_CALENDAR_RESOURCES_COLLECTION=calendar_resources_collection_id
# name: calendar_reminders
NEXT_PUBLIC_APPWRITE_CALENDAR_REMINDERS_COLLECTION=calendar_reminders_collection_id
NEXT_PUBLIC_APPWRITE_CALENDAR_DELEGATIONS_COLLECTION=calendar_delegations_collection_id
NEXT_PUBLIC_APPWRITE_CALENDAR_INTEGRATIONS_COLLECTION=calendar_integrations_collection_id
NEXT_PUBLIC_APPWRITE_CALENDAR_PERMISSION_OVERRIDES_COLLECTION=calendar_permission_overrides_collection_id
