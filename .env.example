# --- Funding & Retention ---
NEXT_PUBLIC_APPWRITE_FUNDING_PURSUITS_COLLECTION=funding_pursuits_collection_id
NEXT_PUBLIC_APPWRITE_CONTRACT_OBLIGATIONS_COLLECTION=contract_obligations_collection_id

# --- Other ---
NEXT_PUBLIC_APPWRITE_RECENT_ACTIVITIES_COLLECTION=recent_activities_collection_id
NEXT_PUBLIC_APPWRITE_REPORTS_COLLECTION=reports_collection_id
NEXT_PUBLIC_APPWRITE_SMS_FORM_SUBMISSIONS_COLLECTION=sms_form_submissions_collection_id

# ==========================================
# AUTHENTICATION
# ==========================================
MICROSOFT_CLIENT_ID=microsoft_client_id
MICROSOFT_CLIENT_SECRET=microsoft_client_secret
MICROSOFT_TENANT_ID=microsoft_tenant_id

# ==========================================
# EXTERNAL SERVICES & APIS
# ==========================================
# Stripe billing (test mode keys for local; use live keys in production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
# Enable Stripe Tax on Checkout (requires Tax activated in Stripe Dashboard)
STRIPE_AUTOMATIC_TAX=true
# Card-on-file Checkout trial (90 days). 0 disables. Pilots skip this and charge on convert.
STRIPE_CHECKOUT_TRIAL_DAYS=90
# In Stripe Dashboard → Settings → Billing → Customer portal: enable
# subscription updates + proration.
# Webhook events: checkout.session.completed, customer.subscription.*,
# invoice.paid, invoice.payment_failed, invoice.finalized,
# credit_note.created, quote.accepted
# Dashboard (no API): Billing → Revenue recovery → Smart Retries;
# Settings → Branding for invoice logo/color.

# Email (Mailgun)
MAILGUN_API_KEY=mailgun_api_key
MAILGUN_DOMAIN=caalmsolutions.com

# Google (Document AI, Places, Gemini)
GOOGLE_LOCATION=us
GOOGLE_API_KEY=google_api_key
GOOGLE_PROJECT_ID=google_project_id
GOOGLE_PROCESSOR_ID=google_processor_id
GOOGLE_PLACES_API_KEY=google_places_api_key
GOOGLE_APPLICATION_CREDENTIALS=google_application_credentials

# SMS (Twilio)
TWILIO_AUTH_TOKEN=twilio_auth_token
TWILIO_ACCOUNT_SID=twilio_account_sid
TWILIO_PHONE_NUMBER=twilio_phone_number

# Weather API route uses server-side OPENWEATHER_API_KEY
OPENWEATHER_API_KEY=openweather_api_key

# SAM.gov
GOV_API_KEY=gov_api_key

# Web Push (desktop alerts) — generate once: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=vapid_public_key
VAPID_PRIVATE_KEY=vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=vapid_public_key
VAPID_SUBJECT=mailto:support@caalm.com

# Redis / Vercel KV (optional locally; used for cache + distributed rate limiting)
REDIS_URL=redis_connection_url
KV_REST_API_URL=vercel_kv_rest_api_url
KV_REST_API_TOKEN=vercel_kv_rest_api_token

# Rate limiting (production middleware + penalties)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOG_MODE=false
RATE_LIMIT_BAN_THRESHOLD=10
RATE_LIMIT_BAN_DURATION=300

# AI / media (optional)
ELEVENLABS_API_KEY=elevenlabs_api_key
# Default voice Rachel (Free API OK). Library voices need Starter+.
ELEVENLABS_VOICE_ID=elevenlabs_voice_id
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=elevenlabs_voice_id
IMAGINE_ART_API_KEY=imagine_art_api_key
REPLICATE_API_TOKEN=replicate_api_token
NEXT_PUBLIC_SPLINE_SCENE_URL=/scene.splinecode
STABLE_DIFFUSION_API_URL=http://localhost:8000
REPLICATE_MODEL=replicate_model_id

# IT runbook alert integrations (optional until providers are wired)
PAGERDUTY_API_TOKEN=
OPSGENIE_API_KEY=
RUNBOOKS_WEBHOOK_SECRET=

# ==========================================
# SCHEDULED JOBS
# ==========================================
# Protect /api/cron/* and the calendar reminder processor
CRON_SECRET=cron_secret
CRON_SECRET_TOKEN=cron_secret_token
SCHEDULER_SECRET=scheduler_secret

# ==========================================
# FEATURE FLAGS
# ==========================================
SHOW_COMING_SOON=true

# ==========================================
# TICKETS / GITHUB
# ==========================================
# Leave TICKETS_ENABLED=false until secrets are set.
TICKETS_ENABLED=false
GITHUB_APP_ID=github_app_id
GITHUB_APP_PRIVATE_KEY=github_app_private_key
GITHUB_WEBHOOK_SECRET=github_webhook_secret
GITHUB_INSTALLATION_ID=github_installation_id
GITHUB_TICKETS_REPO=owner/repo
GITHUB_TOKEN=git_hub_token
CURSOR_API_KEY=cursor_api_key

# ==========================================
# CLM ROADMAP
# ==========================================
# Memory store by default; set ROADMAP_USE_APPWRITE=true after creating tables.
ROADMAP_USE_APPWRITE=false
ROADMAP_WEBHOOK_SECRET=roadmap_webhook_secret

# ==========================================
# DEMO
# ==========================================
# Same Appwrite project, separate caalm-demo database. See .env.demo.example
# APP_MODE=demo
# NEXT_PUBLIC_APP_MODE=demo
# NEXT_PUBLIC_APPWRITE_DATABASE=caalm-demo
# PROD_APPWRITE_DATABASE_ID=prod_appwrite_database_id
# DEMO_OTP_CODE=demo_otp_code
# NEXT_PUBLIC_DEMO_OTP_HINT=demo_otp_hint
# DEMO_ORG_TTL_DAYS=7

# ==========================================
# TESTING
# ==========================================
# Users collection document $id for Playwright auth.setup.js (see GITHUB_SECRETS_SETUP.md)
PLAYWRIGHT_E2E_USER_ID=playwright_e2e_user_id

# ==========================================
# ADOBE PDF SERVICES
# ==========================================
ADOBE_PDF_CLIENT_ID=adobe_pdf_client_id
ADOBE_PDF_CLIENT_SECRET=adobe_pdf_client_secret
