# --- Audits ---
NEXT_PUBLIC_APPWRITE_AUDITS_COLLECTION=audits_collection_id
NEXT_PUBLIC_APPWRITE_AUDIT_LOGS_COLLECTION=audit_logs_collection_id
# name: audit_readiness_snapshots
NEXT_PUBLIC_APPWRITE_AUDIT_READINESS_SNAPSHOTS_COLLECTION=audit_readiness_snapshots_collection_id
# name: audit_evidence_map
NEXT_PUBLIC_APPWRITE_AUDIT_EVIDENCE_MAP_COLLECTION=audit_evidence_map_collection_id

# --- Notifications ---
NEXT_PUBLIC_APPWRITE_NOTIFICATIONS_COLLECTION=notifications_collection_id
NEXT_PUBLIC_APPWRITE_NOTIFICATION_TYPES_COLLECTION=notification_types_collection_id
NEXT_PUBLIC_APPWRITE_NOTIFICATION_SETTINGS_COLLECTION=notification_settings_collection_id
