# Appwrite Function Environment Variables
APPWRITE_FUNCTION_PROJECT_ID=appwrite_function_project_id
APPWRITE_FUNCTION_ENDPOINT=https://fra.cloud.appwrite.io/v1

MAILGUN_API_KEY=mailgun_api_key
MAILGUN_DOMAIN=caalmsolutions.com

GOOGLE_LOCATION=us
GOOGLE_API_KEY=google_api_key
GOOGLE_PROJECT_ID=google_project_id
GOOGLE_PROCESSOR_ID=google_processor_id
GOOGLE_PLACES_API_KEY=google_places_api_key
GOOGLE_APPLICATION_CREDENTIALS=google_application_credentials

GOV_API_KEY=gov_api_key

TWILIO_AUTH_TOKEN=twilio_auth_token
TWILIO_ACCOUNT_SID=twilio_account_sid
TWILIO_PHONE_NUMBER=twilio_phone_number

# Weather API route uses server-side OPENWEATHER_API_KEY (can match NEXT_PUBLIC_OPENWEATHER_API_KEY)
OPENWEATHER_API_KEY=openweather_api_key

# Cron / scheduled jobs (protect /api/cron/* and reminder processor)
CRON_SECRET=cron_secret
CRON_SECRET_TOKEN=cron_secret_token
SCHEDULER_SECRET=scheduler_secret

# Redis / Vercel KV (optional locally; used for cache + distributed rate limiting in production)
REDIS_URL=redis_connection_url
KV_REST_API_URL=vercel_kv_rest_api_url
KV_REST_API_TOKEN=vercel_kv_rest_api_token

# Rate limiting (production middleware + penalties)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOG_MODE=false
RATE_LIMIT_BAN_THRESHOLD=10
RATE_LIMIT_BAN_DURATION=300

# AI / media (optional features)
ELEVENLABS_API_KEY=elevenlabs_api_key
IMAGINE_ART_API_KEY=imagine_art_api_key
REPLICATE_API_TOKEN=replicate_api_token
NEXT_PUBLIC_SPLINE_SCENE_URL=/scene.splinecode
STABLE_DIFFUSION_API_URL=http://localhost:8000
REPLICATE_MODEL=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b

# Stripe billing (test mode keys for local; use live keys in production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

SHOW_COMING_SOON=true

