{
	"name": "caalm-next",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": "^18.18.0 || ^19.8.0 || >=20.0.0"
	},
	"scripts": {
		"dev": "next dev --turbo",
		"dev:setup": "node scripts/setup-dev.js && pnpm run dev",
		"restart": "taskkill /F /IM node.exe 2>nul || echo \"No Node processes to kill\" && pnpm run dev",
		"build": "next build",
		"build:prod": "NODE_ENV=production next build",
		"start": "next start",
		"start:prod": "NODE_ENV=production next start",
		"lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
		"test": "playwright test",
		"test:unit": "vitest",
		"test:unit:ui": "vitest --ui",
		"test:unit:watch": "vitest --watch",
		"test:unit:coverage": "vitest --coverage",
		"test:api-authz": "vitest run tests/rbac/api-authz-matrix.test.ts",
		"api-authz:baseline": "tsx scripts/generate-api-authz-baseline.ts",
		"new:api-route": "tsx scripts/new-api-route.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:clean": "playwright test --reporter=html && rm -rf test-results",
		"test:all": "pnpm test:unit && pnpm test:e2e",
		"clean:test-results": "rm -rf test-results",
		"clean": "pnpm store prune",
		"clean:deps": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"deps:update": "pnpm update --latest",
		"deps:check": "pnpm outdated",
		"test:redis": "node scripts/test-redis.js",
		"vercel:delete-env": "node src/scripts/delete-vercel-env-vars.js",
		"preinstall": "npx only-allow pnpm",
		"lint-format": "biome check --write",
		"lint-fix": "biome check --write --unsafe",
		"lint-check": "biome check --max-diagnostics=100"
	},
