{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": true
	},
	"ignoreCommand": "exit 1",
	"crons": [
		{
			"path": "/api/notifications/process-digest",
			"schedule": "0 9 * * *"
		},
		{
			"path": "/api/contracts/update-expired",
			"schedule": "0 1 * * *"
		},
		{
			"path": "/api/cron/check-contracts",
			"schedule": "0 8 * * *"
		},
		{
			"path": "/api/cron/demo-cleanup",
			"schedule": "0 4 * * *"
		},
		{
			"path": "/api/cron/audit-readiness",
			"schedule": "0 13 * * *"
		},
		{
			"path": "/api/cron/calendar-reminders",
			"schedule": "0 8 * * *"
		},
		{
			"path": "/api/cron/approval-sla",
			"schedule": "0 * * * *"
		}
	]
}
