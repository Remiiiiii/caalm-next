# =============================================================================
# CAALM Demo environment — same Appwrite PROJECT, separate DATABASE
# NEVER set NEXT_PUBLIC_APPWRITE_DATABASE to production caalm-dev.
# =============================================================================

NEXT_PUBLIC_APP_URL= https://caalm-demo.vercel.app
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
DEMO_OTP_CODE=123456
NEXT_PUBLIC_DEMO_OTP_HINT=123456
DEMO_ORG_TTL_DAYS=7

# Refuse guard: demo mode throws if database ID matches this
PROD_APPWRITE_DATABASE_ID=685ed87c0009d8189fc7

# --- Same project as prod; DIFFERENT database ---
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=685ed77d00186ae8176b
NEXT_PUBLIC_APPWRITE_DATABASE=caalm-demo
NEXT_APPWRITE_API_KEY=your_api_key_for_project

