# ==========================================
# AUTHENTICATION
# ==========================================
# Intentionally OMIT on demo (stubs/no-ops when APP_MODE=demo):
# MICROSOFT_*

# ==========================================
# EXTERNAL SERVICES & APIS
# ==========================================
# Stripe keys may be test-mode if you want checkout UI; otherwise omit.
# Intentionally OMIT on demo: MAILGUN_API_KEY, TWILIO_*

# Live Gemini extraction (same as prod; use a quota-limited key on demo)
GOOGLE_API_KEY=your_google_api_key_for_gemini

OPENWEATHER_API_KEY=your_openweather_api_key

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:support@caalmsolutions.com

# ==========================================
# SCHEDULED JOBS
# ==========================================
CRON_SECRET=demo_cron_secret
CRON_SECRET_TOKEN=demo_cron_secret
SCHEDULER_SECRET=demo_scheduler_secret

# ==========================================
# FEATURE FLAGS
# ==========================================
SHOW_COMING_SOON=false

# ==========================================
# TICKETS / GITHUB
# ==========================================
TICKETS_ENABLED=true
GITHUB_APP_ID=github_app_id
GITHUB_APP_PRIVATE_KEY=github_app_private_key
GITHUB_WEBHOOK_SECRET=github_webhook_secret
GITHUB_INSTALLATION_ID=github_installation_id
GITHUB_TICKETS_REPO=Remiiiiii/caalm-next
CURSOR_API_KEY=cursor_api_key

# ==========================================
# SETUP
# ==========================================
# 1. Database caalm-demo exists; keep schema synced: `pnpm sync:demo-db:apply`
# 2. Seed permissions + role_permissions into caalm-demo (roles already seeded)
# 3. Deploy separate Vercel env with these vars including TASKS + GOOGLE_API_KEY
# 4. Visit /try → sign up → OTP 123456 → dashboard
