# ==========================================
# APP CONFIGURATION — DEMO TEMPLATE (placeholders only)
# ==========================================
# Committed checklist of keys for caalm-demo (Vercel + local).
# Real values live in gitignored `.env.demo.local` (create with `pnpm demo:env:init`).
# NEVER set NEXT_PUBLIC_APPWRITE_DATABASE to production caalm-dev.
NEXT_PUBLIC_APP_URL=https://caalm-demo.vercel.app
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
DEMO_OTP_CODE=123456
NEXT_PUBLIC_DEMO_OTP_HINT=123456
DEMO_ORG_TTL_DAYS=7
PROD_APPWRITE_DATABASE_ID=prod_appwrite_database_id
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate_a_unique_key_for_demo
STEP_UP_SECRET=demo_step_up_secret_placeholder

# ==========================================
# APPWRITE
# ==========================================
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=project_id
NEXT_PUBLIC_APPWRITE_DATABASE=caalm-demo
NEXT_APPWRITE_API_KEY=your_api_key_for_project
NEXT_PUBLIC_APPWRITE_BUCKET=demo_bucket_id
NEXT_PUBLIC_APPWRITE_PROFILE_PICTURES_BUCKET=profile_pictures_bucket_id
# name: contract_blueprints
NEXT_PUBLIC_APPWRITE_CONTRACT_BLUEPRINTS_BUCKET=contract_blueprints_bucket_id
# name: organization_logos
NEXT_PUBLIC_APPWRITE_ORGANIZATION_LOGOS_BUCKET=organization_logos_bucket_id

