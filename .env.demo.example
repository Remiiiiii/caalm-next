# ==========================================
# AUTHENTICATION
# ==========================================
# Intentionally OMIT on demo (stubs/no-ops when APP_MODE=demo):
# MICROSOFT_*

# ==========================================
# EXTERNAL SERVICES & APIS
# ==========================================
# Stripe keys may be test-mode if you want checkout UI; otherwise omit.
# Intentionally OMIT on demo: MAILGUN_API_KEY, TWILIO_*

# Live Gemini extraction (same as prod; use a quota-limited key on demo)
GOOGLE_API_KEY=your_google_api_key_for_gemini

OPENWEATHER_API_KEY=your_openweather_api_key

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:support@caalmsolutions.com

# ==========================================
# SCHEDULED JOBS
# ==========================================
# Use strong random values in `.env.demo.local` and Vercel — never commit them.
CRON_SECRET=demo_cron_secret_placeholder
CRON_SECRET_TOKEN=demo_cron_secret_token_placeholder
SCHEDULER_SECRET=demo_scheduler_secret_placeholder
NEGOTIATE_SESSION_SECRET=demo_negotiate_session_secret_placeholder

# ==========================================
# FEATURE FLAGS
# ==========================================
SHOW_COMING_SOON=false

# ==========================================
# TICKETS / GITHUB
# ==========================================
TICKETS_ENABLED=true
GITHUB_APP_ID=github_app_id
GITHUB_APP_PRIVATE_KEY=github_app_private_key
GITHUB_WEBHOOK_SECRET=github_webhook_secret
GITHUB_INSTALLATION_ID=github_installation_id
GITHUB_TICKETS_REPO=owner/repo
CURSOR_API_KEY=cursor_api_key

# ==========================================
# CLM ROADMAP
# ==========================================
ROADMAP_USE_APPWRITE=false
ROADMAP_WEBHOOK_SECRET=roadmap_webhook_secret_placeholder

# ==========================================
# OPTIONAL INTEGRATIONS
# ==========================================
# Same key names as `.env.example`. Omit on demo unless that feature is on:
# Stripe, HubSpot, Redis/KV, Adobe/Gotenberg, ElevenLabs, Microsoft, Mailgun, Twilio.
# Collection/bucket IDs above should stay in parity with `.env.example`.

# ==========================================
# SETUP
# ==========================================
# 1. `pnpm demo:env:init` → edit `.env.demo.local` with real Appwrite IDs + secrets
# 2. Database caalm-demo exists; keep schema synced: `pnpm sync:demo-db:apply`
# 3. Seed permissions + role_permissions into caalm-demo
# 4. Push to Vercel: `pnpm sync:vercel-env:apply` (uses `.env.demo.local`)
# 5. Visit /try → sign up → OTP 123456 → dashboard
