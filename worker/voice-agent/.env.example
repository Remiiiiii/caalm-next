# LiveKit (same project as the main app's LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=lk_api_key
LIVEKIT_API_SECRET=lk_api_secret

# Shared Claude/Anthropic key — reuse the main app's CLAUDE_API_KEY value.
CLAUDE_API_KEY=claude_api_key
CLAUDE_SONNET_MODEL=claude-sonnet-5-5

# Shared ElevenLabs API key — reuse the main app's ELEVENLABS_API_KEY.
ELEVENLABS_API_KEY=elevenlabs_api_key
# Optional shared default (used only if ELEVENLABS_AUDIT_LAB_VOICE_ID is unset).
ELEVENLABS_VOICE_ID=elevenlabs_voice_id
# Audit Lab interviewer voice (Practice & Roleplay). Prefer this over ELEVENLABS_VOICE_ID.
ELEVENLABS_AUDIT_LAB_VOICE_ID=elevenlabs_audit_lab_voice_id

# New: speech-to-text. https://console.deepgram.com
DEEPGRAM_API_KEY=deepgram_api_key

# Calls back into the main app's internal turn endpoint.
NEXT_PUBLIC_APP_URL=https://your-caalm-deployment.example.com
# Must exactly match VOICE_AGENT_SHARED_SECRET in the main app's env — generate
# a long random string, e.g. `openssl rand -hex 32`.
VOICE_AGENT_SHARED_SECRET=voice_agent_shared_secret

# Optional talking-head interviewer (Synthesia). Soft-falls back to audio-only when unset.
# API key: https://www.synthesia.io / developers workspace
SYNTHESIA_API_KEY=synthesia_api_key
# Use Prepare Interactive ID / Copy Interactive ID from Studio (••• menu), NOT Copy ID.
# Bare UUID is fine; the LiveKit plugin prefixes av_ when calling Synthesia.
# Example interactive id (Copy ID alone returns unknown_reference / 404):
SYNTHESIA_AVATAR_ID=da4ed02b-9ba7-43d3-99ef-145243697cdf
# Set to "true" in local dev to skip the real Synthesia API call (no credits spent)
# and stay audio-only. Leave unset in staging/production.
SYNTHESIA_DRY_RUN=true
