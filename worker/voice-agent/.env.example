# LiveKit (same project as the main app's LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=lk_api_key
LIVEKIT_API_SECRET=lk_api_secret

# Shared Claude/Anthropic key — reuse the main app's CLAUDE_API_KEY value.
CLAUDE_API_KEY=claude-api-key
CLAUDE_SONNET_MODEL=claude-sonnet-5-5

# Shared ElevenLabs key — reuse the main app's ELEVENLABS_API_KEY/ELEVENLABS_VOICE_ID values.
ELEVENLABS_API_KEY=elevenlabs-api-key
ELEVENLABS_VOICE_ID=elevenlabs-voice-id

# New: speech-to-text. https://console.deepgram.com
DEEPGRAM_API_KEY=deepgram-api-key

# Calls back into the main app's internal turn endpoint.
NEXT_PUBLIC_APP_URL=https://your-caalm-deployment.example.com
# Must exactly match VOICE_AGENT_SHARED_SECRET in the main app's env — generate
# a long random string, e.g. `openssl rand -hex 32`.
VOICE_AGENT_SHARED_SECRET=voice-agent-shared-secret
