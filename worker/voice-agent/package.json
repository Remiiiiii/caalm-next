{
	"name": "@caalm/voice-agent",
	"version": "0.1.0",
	"private": true,
	"description": "LiveKit Agents worker: the live AI interviewer for Audit Lab's Practice & Roleplay (Phase 1, voice-only).",
	"type": "module",
	"scripts": {
		"start:dev": "tsx src/agent.ts dev",
		"dev": "tsx src/agent.ts dev",
		"start": "tsx src/agent.ts start",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsx --test src/**/*.test.ts"
	},
	"dependencies": {
		"@livekit/agents": "1.10.1",
		"@livekit/agents-plugin-anthropic": "1.10.1",
		"@livekit/agents-plugin-deepgram": "1.10.1",
		"@livekit/agents-plugin-elevenlabs": "1.10.1",
		"@livekit/agents-plugin-silero": "1.10.1",
		"@livekit/agents-plugin-synthesia": "1.10.1",
		"@livekit/noise-cancellation-node": "0.3.1",
		"@livekit/rtc-node": "^1.2.2",
		"dotenv": "^17.2.4",
		"livekit-server-sdk": "^2.20.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
